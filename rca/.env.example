# Databricks Credentials
DATABRICKS_HOST=https://adb-xxxxxx.x.azuredatabricks.net
DATABRICKS_TOKEN=dapi...

# LLM Configuration (Generic)
LLM_MODEL=databricks/dbrx-instruct
# Uses DATABRICKS_TOKEN by default with LiteLLM

# Manifest & Metrics Tables
RCA_MANIFEST_TABLE=rca_manifest_log
RCA_METRICS_TABLE=rca_metrics_history

# Anomaly Detection Thresholds
RCA_ANOMALY_Z_SCORE=3.0
RCA_ANOMALY_DROP_RATE=0.1
RCA_ANOMALY_VOL_DROP=0.3
RCA_ANOMALY_FRESHNESS_DELAY=2.0
RCA_ANOMALY_REJECTION_RATE=0.05

# Limits & Retry
RCA_MAX_FILE_SIZE_MB=1
RCA_LLM_MAX_RETRIES=3
RCA_LLM_RETRY_DELAY=2
